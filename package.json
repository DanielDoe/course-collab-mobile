{
  "name": "course-collab-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "CourseCollab native mobile app (iOS, Android, iPadOS) — mirrors the mobile web experience",
  "scripts": {
    "build": "node scripts/generate-assets.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "dev:emulator": "bash scripts/start-emulator.sh",
    "dev:android": "bash scripts/start-emulator.sh && source scripts/setup-env.sh && npx cap run android --target CourseCollab_Pixel",
    "expo:install": "cd expo && npm install",
    "expo:start": "cd expo && npx expo start",
    "release:audit": "cd expo && npm run release:audit",
    "release:audit:mobile": "cd expo && npm run release:audit:mobile",
    "audit:coursecollab": "node scripts/audit-coursecollab.mjs",
    "audit:mobile-production": "cd expo && npm run audit:mobile-production",
    "audit:ios": "cd expo && npm run audit:ios",
    "audit:appstore": "cd expo && npm run audit:appstore"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
