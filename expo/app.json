{
  "expo": {
    "name": "CourseCollab",
    "slug": "course-collab-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo-mark.png",
    "scheme": "coursecollab",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#582c83",
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/61d3c8bd-2fce-4373-92cb-6f558f9e3cbd",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coursecollab.app",
      "buildNumber": "1",
      "icon": "./assets/CourseCollab.icon",
      "backgroundColor": "#F2F2F7",
      "associatedDomains": [
        "applinks:coursecollab.vercel.app",
        "applinks:course-collab.com",
        "applinks:www.course-collab.com"
      ],
      "infoPlist": {
        "UIUserInterfaceStyle": "Automatic",
        "NSCalendarsUsageDescription": "CourseCollab adds your class schedule to Apple Calendar and sends class reminders.",
        "NSCalendarsFullAccessUsageDescription": "CourseCollab adds your class schedule to Apple Calendar and sends class reminders.",
        "NSUserNotificationsUsageDescription": "CourseCollab sends class reminders, quiz deadlines, announcements, and course messages.",
        "NSSpeechRecognitionUsageDescription": "CourseCollab uses speech recognition for live captions in AI Notetaker and voice dictation in Cora.",
        "NSMicrophoneUsageDescription": "CourseCollab needs microphone access for lecture recording in AI Notetaker and voice dictation in Cora.",
        "NSCameraUsageDescription": "CourseCollab uses the camera when you choose to capture and upload coursework or profile content.",
        "NSPhotoLibraryUsageDescription": "CourseCollab needs photo access when you choose to upload coursework or profile content.",
        "NSFaceIDUsageDescription": "CourseCollab uses Face ID to protect your saved login session in Secure Store.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "webcal",
          "webcals"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.coursecollab.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "appUrl": "https://coursecollab.vercel.app",
      "environment": "production",
      "router": {},
      "eas": {
        "projectId": "61d3c8bd-2fce-4373-92cb-6f558f9e3cbd"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#582c83",
          "image": "./assets/logo-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "CourseCollab uses Face ID to protect your saved login session in Secure Store."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-mark.png",
          "color": "#6D5EF6",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CourseCollab adds your recurring class schedule to Apple Calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CourseCollab needs photo access for assignment uploads.",
          "cameraPermission": "CourseCollab needs camera access for assignment photos."
        }
      ],
      "expo-speech-recognition",
      "expo-audio",
      "expo-system-ui",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "buildReactNativeFromSource": true,
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "@config-plugins/react-native-pdf",
      "@config-plugins/react-native-blob-util",
      "expo-image"
    ],
    "owner": "danieldoe"
  }
}
